# CaseFlow Agent local environment template
#
# Copy to .env.local (gitignored). The MVP runs entirely locally and
# requires NO credentials of any kind.

# Application mode. Use local for the demo.
CASEFLOW_APP_MODE=local

# Model mode. Deterministic mode uses local mock agent behavior.
CASEFLOW_MODEL_MODE=deterministic

# Backend log level.
CASEFLOW_LOG_LEVEL=INFO

# Seed the focused two-document demo request on backend startup.
CASEFLOW_SEED_ON_STARTUP=true
CASEFLOW_SEED_DATASET=demo

# Later phases only. Leave unset for the local demo. Never commit real values.
# CASEFLOW_GEMINI_API_KEY=
# CASEFLOW_GCP_PROJECT=
# CASEFLOW_GCS_BUCKET=
# CASEFLOW_AGENT_SEARCH_DATASTORE=
