# CaseFlow Agent — local environment template
#
# Copy to .env.local (gitignored). The MVP runs entirely locally and
# requires NO credentials of any kind.

# Application mode. Only "local" is supported until the GCP adapters PR.
APP_MODE=local

# Model mode. Only "deterministic" is supported until the Gemini PR
# adds "mock_model" and "gemini".
MODEL_MODE=deterministic

# Backend log level.
LOG_LEVEL=info

# --- Later phases only. Leave unset for the MVP. Never commit real values. ---
# GEMINI_API_KEY=        # Gemini integration PR (PR 8)
# GOOGLE_CLOUD_PROJECT=  # GCP adapters PR (PR 10)
